{
    "name": "app-verk/google-cloud-storage-media-bundle",
    "description": "AppVerk media bundle uploading into Google Cloud Storage",
    "type": "symfony-bundle",
    "autoload": {
        "psr-4": {
            "AppVerk\\GoogleCloudStorageMediaBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppVerk\\GoogleCloudStorageMediaBundle\\Tests\\": "Tests/"
        }
    },
    "authors": [
        {
            "name": "Michał Jędraszczyk",
            "email": "michal.jedraszczyk@appverk.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "app-verk/components": "^2.0 || dev-master",
        "league/flysystem-bundle": "^3.3",
        "google/cloud-storage": "*",
        "symfony/routing": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/form": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "doctrine/orm": "*"
    },
    "suggest": {
        "league/flysystem-google-cloud-storage": "*"
    }
}
